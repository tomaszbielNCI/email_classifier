# Email Classifier Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection string (if using database for storing results)
DATABASE_URL=sqlite:///./results/email_classifier.db

# =============================================================================
# EVENT BUS CONFIGURATION
# =============================================================================
# Redis configuration for event-driven architecture
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ configuration (alternative to Redis)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# =============================================================================
# API CONFIGURATION
# =============================================================================
# FastAPI server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# API Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
# Model storage path
MODEL_STORAGE_PATH=./results/models/

# Data paths
DATA_PATH=./data/
RAW_DATA_PATH=./data/raw/
PROCESSED_DATA_PATH=./data/processed/

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=./results/logs/email_classifier.log

# =============================================================================
# TRANSLATION CONFIGURATION
# =============================================================================
# Translation model configuration
TRANSLATION_ENABLED=false
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-mul-en
TRANSLATION_BATCH_SIZE=32

# =============================================================================
# VECTORIZATION CONFIGURATION
# =============================================================================
# Text vectorization settings
VECTORIZATION_METHOD=tfidf
TFIDF_MAX_FEATURES=15000
TFIDF_NGRAM_RANGE_MIN=1
TFIDF_NGRAM_RANGE_MAX=3

# Embedding model settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# SAMPLING CONFIGURATION
# =============================================================================
# Data balancing settings
SAMPLING_ENABLED=true
SAMPLING_METHOD=smote
SAMPLING_MAX_RATIO=2.0

# =============================================================================
# MODELING CONFIGURATION
# =============================================================================
# Default models to use
DEFAULT_MODELS=random_forest,logistic_regression,naive_bayes

# Hyperparameter tuning
HYPERPARAMETER_TUNING=false
CROSS_VALIDATION_FOLDS=5

# Random state for reproducibility
RANDOM_STATE=42

# =============================================================================
# STRATEGY CONFIGURATION
# =============================================================================
# Multi-label strategy (chained or hierarchical)
DEFAULT_STRATEGY=chained

# Hierarchical strategy settings
HIERARCHICAL_MIN_SAMPLES_PER_CLASS=5

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Performance monitoring
MONITORING_ENABLED=false
METRICS_PORT=9090

# Health check configuration
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development settings
DEBUG=false
TEST_MODE=false
MOCK_EXTERNAL_APIS=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker settings
DOCKER_REGISTRY=your-registry.com
DOCKER_TAG=latest

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Email notifications (for monitoring)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@example.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
# Caching settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
